# ============================================================
# AIREX — Environment Template (Phase 0 + Phase 1)
# Copy to .env and adjust. NEVER commit .env.
# ============================================================

APP_ENV=development
APP_NAME=airex
APP_VERSION=0.1.0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL, async driver)
DATABASE_URL=postgresql+asyncpg://airex:airex@postgres:5432/airex
# Local/test fallback (no Postgres required for unit tests)
# DATABASE_URL=sqlite+aiosqlite:///./data/airex.db

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Client-side structured logging verbosity: debug | info | warn | error (default: debug)
NEXT_PUBLIC_LOG_LEVEL=debug

# Logging / Observability
LOG_LEVEL=INFO
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_ENABLED=true

# AI Providers (OPTIONAL — local implementation used when empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Phase 1 — Credential encryption (Fernet key, base64 of 32 bytes).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Phase 1 — Model invocation limits
MODEL_INVOKE_TIMEOUT_SECONDS=30
MODEL_MAX_TOKENS_MAX=32768
MODEL_MAX_TOKENS_DEFAULT=1024
MODEL_TEMPERATURE_MAX=2.0

# Phase 1 — Rate limits (requests per window)
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_MODEL_TEST_LIMIT=60
RATE_LIMIT_MODEL_TEST_WINDOW_SECONDS=60
RATE_LIMIT_MODEL_INVOKE_LIMIT=120
RATE_LIMIT_MODEL_INVOKE_WINDOW_SECONDS=60

# Seed (development only)
SEED_DEMO_PASSWORD=demo-password-123
