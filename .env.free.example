# ==============================================================================
# AIREX Zero-Cost Cloud Deployment Environment Template (.env.free.example)
# Target: Oracle Cloud Always Free (ARM / Single-Node k3s)
# Note: Copy this file to .env.free on your deployment target. DO NOT COMMIT .env.free!
# ==============================================================================

# --- Target Host & Networking Configuration ---
# Public IPv4 address assigned to your Oracle Always Free VM (e.g., 129.153.45.67)
ORACLE_VM_PUBLIC_IP=CHANGE_ME_ORACLE_VM_PUBLIC_IP

# Free Wildcard DNS domain (auto-derived from ORACLE_VM_PUBLIC_IP: app.<IP>.sslip.io)
PUBLIC_DOMAIN=app.CHANGE_ME_ORACLE_VM_PUBLIC_IP.sslip.io
API_DOMAIN=api.CHANGE_ME_ORACLE_VM_PUBLIC_IP.sslip.io

# --- Application Security Keys ---
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_APPLICATION_SECRET_KEY_64_HEX
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Key for encrypting stored credentials / secrets (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY_BASE64

# --- In-Cluster PostgreSQL Database Configuration ---
# Note: Postgres runs in-cluster on internal service: postgres-service:5432
POSTGRES_USER=airex
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD_32_HEX
POSTGRES_DB=airex
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://airex:CHANGE_ME_DATABASE_PASSWORD_32_HEX@postgres-service:5432/airex

# --- In-Cluster Redis Cache & Queue Configuration ---
# Note: Redis runs in-cluster on internal service: redis-service:6379
# Generate with: openssl rand -hex 16
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_32_HEX
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD_32_HEX@redis-service:6379/0

# --- Container Registry Configuration ---
# GitHub Container Registry (ghcr.io)
CONTAINER_REGISTRY=ghcr.io/CHANGE_ME_GITHUB_USERNAME
IMAGE_TAG=latest
# GitHub Personal Access Token (PAT) with read:packages scope (if pulling private images)
GHCR_PAT_TOKEN=CHANGE_ME_GITHUB_PAT_TOKEN

# --- AI Provider API Keys (Optional / Runtime) ---
# Add your provider keys if executing live model evaluations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# --- Environment Profile ---
ENVIRONMENT=free-tier
LOG_LEVEL=INFO
ENABLE_REGISTRATION=true
CORS_ORIGINS=http://localhost:3000,http://app.CHANGE_ME_ORACLE_VM_PUBLIC_IP.sslip.io,https://app.CHANGE_ME_ORACLE_VM_PUBLIC_IP.sslip.io
